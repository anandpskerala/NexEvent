FROM node:22-alpine AS build
WORKDIR /app

RUN npm install -g pnpm


COPY pnpm-lock.yaml ./
COPY package.json ./
RUN pnpm install

COPY . .
ARG VITE_BACKEND_URL
ARG VITE_SOCKET_URL
ARG VITE_FIREBASE_KEY
ARG VITE_FIREBASE_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE
ARG VITE_FIREBASE_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_MEASUREMENT_ID
ARG VITE_CLOUD_NAME
ARG VITE_CLOUD_PRESET
ARG VITE_MAP_API_KEY
ARG VITE_OPENCAGE_API_KEY
ARG VITE_RAZORPAY_KEY_ID
ARG VITE_STRIPE_KEY
ARG VITE_LIVEKIT_URL

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_FIREBASE_KEY=$VITE_FIREBASE_KEY
ENV VITE_FIREBASE_DOMAIN=$VITE_FIREBASE_DOMAIN
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_STORAGE=$VITE_FIREBASE_STORAGE
ENV VITE_FIREBASE_SENDER_ID=$VITE_FIREBASE_SENDER_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_MEASUREMENT_ID=$VITE_FIREBASE_MEASUREMENT_ID
ENV VITE_CLOUD_NAME=$VITE_CLOUD_NAME
ENV VITE_CLOUD_PRESET=$VITE_CLOUD_PRESET
ENV VITE_MAP_API_KEY=$VITE_MAP_API_KEY
ENV VITE_OPENCAGE_API_KEY=$VITE_OPENCAGE_API_KEY
ENV VITE_RAZORPAY_KEY_ID=$VITE_RAZORPAY_KEY_ID
ENV VITE_STRIPE_KEY=$VITE_STRIPE_KEY
ENV VITE_LIVEKIT_URL=$VITE_LIVEKIT_URL

RUN pnpm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
