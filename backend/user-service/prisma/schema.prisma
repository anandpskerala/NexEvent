// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  firstName    String
  lastName     String
  email        String             @unique
  password     String?
  googleId     String?
  authProvider AuthProvider
  roles        Role[]             @default([user])
  phoneNumber  BigInt?
  image        String?
  organizer    OrganizerRequest? 
  organizerId  String?            @unique
  isBlocked    Boolean            @default(false)
  isVerified   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  otp          Otp?
  forgot       ForgotRequest?
  reviews      Review[]

  @@map("users")
}

model OrganizerRequest {
  id              String         @id @default(uuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String         @unique
  organization    String
  website         String?
  reason          String
  documents       String
  status          RequestStatus  @default(pending)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("organizer_requests")
}


model ForgotRequest {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  requestId String   @default(uuid())
  expiry    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forgot_requests")
}

model Review {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  eventId   String
  rating    Int
  title     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

enum AuthProvider {
  google
  email
}

enum Role {
  user
  organizer
  admin

  @@map("Role")
}

enum RequestStatus {
  pending
  accepted
  rejected
}